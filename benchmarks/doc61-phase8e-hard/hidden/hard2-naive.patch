+(defun rq--apply-join (rows right-rows dataset left-field right-field)
+  "Inner-join ROWS against RIGHT-ROWS, preserving input order."
+  (let ((out nil))
+    (dolist (row rows)
+      (dolist (right right-rows)
+        (when (equal (rq-row-get row left-field)
+                     (rq-row-get right right-field))
+          (push (append row
+                        (mapcar (lambda (cell)
+                                  (cons (intern (format "%s.%s" dataset (car cell)))
+                                        (cdr cell)))
+                                right))
+                out))))
+    (nreverse out)))
+
+(defun rq--apply-group-by (rows field)
+  "Group ROWS by FIELD."
+  (let ((groups nil))
+    (dolist (row rows)
+      (let* ((key (rq-row-get row field))
+             (cell (assoc key groups)))
+        (if cell
+            (setcdr cell (1+ (cdr cell)))
+          (push (cons key 1) groups))))
+    (mapcar (lambda (cell)
+              (list (cons :key (car cell))
+                    (cons :count (cdr cell))))
+            (nreverse groups))))
+
