 (defun calc-eval-ast (ast)
   "Evaluate AST produced by `calc-parse'."
   (pcase ast
+    (`(neg ,expr) (- (calc-eval-ast expr)))
     (`(num ,n) n)
     (`(bin "+" ,l ,r) (+ (calc-eval-ast l) (calc-eval-ast r)))
     (`(bin "-" ,l ,r) (- (calc-eval-ast l) (calc-eval-ast r)))
