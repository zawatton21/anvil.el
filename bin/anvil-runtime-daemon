#!/usr/bin/env bash
# anvil-runtime-daemon — persistent daemon for `bin/anvil-runtime'.
#
# NeLisp v1.2.0 (2026-09-04): the daemon is `anvil-runtime server PORT',
# a TCP loopback listener (127.0.0.1:PORT) served by nelisp's process
# adapter -- the same on Linux and Windows.  It replaces the K2
# (2026-05-11) UNIX-socket listener, which was built on the Rust-era
# `nl-ffi-call' contract the pure-elisp reader no longer has.  Bridges
# (`anvil-runtime-stdio') relay each MCP client session to it.
#
# Lifecycle:
#   start    — start `anvil-runtime server PORT' in the background.  With
#              warm caches (`anvil-runtime prewarm' once) it is listening
#              within seconds; a cold state dir spends minutes generating
#              tool schemas first.
#   stop     — kill the daemon process.
#   status   — report running / listening.
#   logs     — tail the daemon stderr log.
#
# Environment:
#   ANVIL_RUNTIME_DAEMON_DIR   state dir (default ~/.anvil-runtime)
#   ANVIL_RUNTIME_PORT         listen port (default 47171)
#   ANVIL_TOOL_MODULES         tool modules, e.g.
#                              anvil-discovery,anvil-sqlite,anvil-bench,anvil-state,anvil-memory,anvil-worklog

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ANVIL_RUNTIME="$script_dir/anvil-runtime"

DIR="${ANVIL_RUNTIME_DAEMON_DIR:-$HOME/.anvil-runtime}"
PORT="${ANVIL_RUNTIME_PORT:-47171}"
PID_FILE="$DIR/daemon.pid"
LOG_FILE="$DIR/daemon.log"

cmd="${1:-status}"

is_running() {
    [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

is_listening() {
    (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null
}

start_daemon() {
    if is_running ; then
        echo "anvil-runtime daemon already running (pid $(cat "$PID_FILE"))" >&2
        return 0
    fi
    if [ ! -x "$ANVIL_RUNTIME" ] ; then
        echo "anvil-runtime: launcher not found / not executable: $ANVIL_RUNTIME" >&2
        exit 1
    fi
    if is_listening ; then
        echo "anvil-runtime: something already listens on 127.0.0.1:$PORT (set ANVIL_RUNTIME_PORT)" >&2
        exit 1
    fi
    mkdir -p "$DIR"

    nohup "$ANVIL_RUNTIME" server "$PORT" </dev/null >>"$LOG_FILE" 2>&1 &
    local daemon_pid=$!
    disown "$daemon_pid" 2>/dev/null || true
    echo "$daemon_pid" > "$PID_FILE"

    echo "anvil-runtime daemon started" >&2
    echo "  daemon pid: $daemon_pid" >&2
    echo "  listen:     127.0.0.1:$PORT" >&2
    echo "  log:        $LOG_FILE" >&2
    echo "" >&2
    echo "Wait for \`status' to say listening before pointing MCP clients at" >&2
    echo "\`bin/anvil-runtime-stdio'.  Seconds with warm caches; run" >&2
    echo "\`bin/anvil-runtime prewarm' first on a cold state dir." >&2
}

stop_daemon() {
    local stopped=0
    if [ -f "$PID_FILE" ] ; then
        local pid
        pid="$(cat "$PID_FILE")"
        if kill -0 "$pid" 2>/dev/null ; then
            local descendants
            descendants="$(pgrep -P "$pid" 2>/dev/null || true)"
            kill "$pid" $descendants 2>/dev/null || true
            sleep 0.3
            kill -9 "$pid" $descendants 2>/dev/null || true
            stopped=1
        fi
        rm -f "$PID_FILE"
    fi
    rm -f "$DIR/sock"
    if [ "$stopped" = 1 ] ; then
        echo "anvil-runtime daemon stopped" >&2
    else
        echo "anvil-runtime daemon was not running" >&2
    fi
}

status_daemon() {
    if is_running ; then
        if is_listening ; then
            echo "running (pid $(cat "$PID_FILE"), listening on 127.0.0.1:$PORT)"
        else
            echo "running (pid $(cat "$PID_FILE"), not listening yet — still loading)"
        fi
        return 0
    else
        echo "stopped"
        return 1
    fi
}

logs_daemon() {
    if [ ! -f "$LOG_FILE" ] ; then
        echo "anvil-runtime daemon log not found: $LOG_FILE" >&2
        exit 1
    fi
    exec tail -n 100 -f "$LOG_FILE"
}

case "$cmd" in
    start)   start_daemon ;;
    stop)    stop_daemon ;;
    restart) stop_daemon ; sleep 0.5 ; start_daemon ;;
    status)  status_daemon ;;
    logs)    logs_daemon ;;
    *)
        cat >&2 <<EOF
usage: anvil-runtime-daemon {start|stop|restart|status|logs}

Environment:
  ANVIL_RUNTIME_DAEMON_DIR   (default: ~/.anvil-runtime) — where pid / log live.
  ANVIL_RUNTIME_PORT         (default: 47171)            — TCP loopback port.
EOF
        exit 2
        ;;
esac
